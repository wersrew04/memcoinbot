DISCORD_WEBHOOK_URL=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_TO=

# ==================== Trading ====================
TRADE_AMOUNT_USD=10.0
MAX_OPEN_POSITIONS=5
STOP_LOSS_PCT=0.10
TAKE_PROFIT_PCT=0.30
TRAILING_STOP_PCT=0.15
COOLDOWN_MINUTES=30
MAX_DAILY_LOSS_USD=20.0
MAX_RISK_PER_TOKEN_USD=10.0
MAX_CONSECUTIVE_LOSSES=5
MAX_DAILY_TRADES=50
MAX_TOKEN_ALLOCATION_PCT=0.25
SLIPPAGE_BPS=300
PAPER_TRADING=true
PRIORITY_FEE_MICROLAMPORTS=50000

# ==================== Filter thresholds ====================
MIN_TOKEN_AGE_MINUTES=1.0
MAX_TOKEN_AGE_MINUTES=15.0
MIN_LIQUIDITY_USD=20000
MAX_LIQUIDITY_USD=0
MIN_MARKET_CAP_USD=50000
MAX_MARKET_CAP_USD=500000
MIN_24H_VOLUME_USD=0
MIN_VOLUME_5M_USD=20000
MIN_VOLUME_SPIKE_PCT=2.0
MIN_BUY_SELL_RATIO=2.0
MIN_HOLDERS=100
MAX_TOP10_HOLDER_PCT=0.30
MAX_DEV_WALLET_PCT=0.10
REQUIRE_LP_LOCKED=true

# ==================== AI Engine ====================
AI_ENABLED=true
AI_MIN_SCORE=55.0
AI_STRONG_BUY_THRESHOLD=80.0
AI_BUY_THRESHOLD=65.0
AI_LEARNING_RATE=0.01
AI_WEIGHT_LIQUIDITY=0.12
AI_WEIGHT_VOLUME=0.10
AI_WEIGHT_HOLDERS=0.08
AI_WEIGHT_WHALE=0.12
AI_WEIGHT_SMART_MONEY=0.15
AI_WEIGHT_MOMENTUM=0.10
AI_WEIGHT_SECURITY=0.15
AI_WEIGHT_SOCIAL=0.08
AI_WEIGHT_AGE=0.05
AI_WEIGHT_SIMILAR=0.05

# ==================== Smart Money ====================
SMART_MONEY_ENABLED=true
SMART_MONEY_MIN_ROI_PCT=200.0
SMART_MONEY_MIN_WIN_RATE=0.70
SMART_MONEY_MIN_TRADES=100
SMART_MONEY_SCORE_BOOST=15.0

# ==================== Whale Tracking ====================
WHALE_TRACKING_ENABLED=true
WHALE_THRESHOLDS_USD=100000,250000,500000,1000000
WHALE_BUY_SCORE_BOOST=10.0
WHALE_SELL_SCORE_PENALTY=12.0

# ==================== Social Intelligence (X.com rasmiy API) ====================
# X_API_BEARER_TOKEN bo'sh bo'lsa, modul avtomatik o'chiq holatda ishlaydi
# (neytral ball qaytaradi, hech qanday tarmoq so'rovi yubormaydi).
SOCIAL_INTELLIGENCE_ENABLED=false
X_API_BEARER_TOKEN=
SOCIAL_API_TIMEOUT_SEC=5.0
SOCIAL_CACHE_TTL_MIN=30.0
SOCIAL_MAX_CALLS_PER_DAY=150
SOCIAL_MIN_MENTIONS_FOR_SIGNAL=3
SOCIAL_INFLUENCER_FOLLOWER_THRESHOLD=20000

# ==================== MEV Protection ====================
MEV_PROTECTION_ENABLED=true
MEV_MAX_SLIPPAGE_BPS=500
MEV_SANDWICH_RISK_THRESHOLD=0.7
MEV_DYNAMIC_SLIPPAGE=true
MEV_RETRY_ATTEMPTS=3

# ==================== Blacklist ====================
AUTO_BLACKLIST_ENABLED=true
BLACKLIST_HONEYPOT=true
BLACKLIST_RUG_PULL=true
BLACKLIST_FAKE_VOLUME=true
BLACKLIST_MALICIOUS=true

# ==================== Advanced Risk ====================
EMERGENCY_STOP=false
AUTO_PAUSE_ON_ERROR=true
MAX_DRAWDOWN_PCT=0.25

# ==================== Portfolio ====================
PORTFOLIO_MAX_SECTOR_PCT=0.40
PORTFOLIO_DIVERSIFICATION_MIN=3

# ==================== Notifications ====================
NOTIFY_TELEGRAM=true
NOTIFY_DISCORD=false
NOTIFY_EMAIL=false
NOTIFY_ON_BUY=true
NOTIFY_ON_SELL=true
NOTIFY_ON_AI_SIGNAL=true
NOTIFY_ON_WHALE=true
NOTIFY_ON_ERROR=true

# ==================== Monitoring ====================
RPC_HEALTH_CHECK_INTERVAL_SEC=60
API_LATENCY_THRESHOLD_MS=2000
AUTO_RECOVERY_ENABLED=true

# ==================== Backtest ====================
BACKTEST_DEFAULT_DAYS=30

# ==================== Monitor interval ====================
POSITION_MONITOR_INTERVAL_SEC=15
SCANNER_INTERVAL_SEC=60
SELL_RETRY_ATTEMPTS=3
PARTIAL_TP_ENABLED=false
PARTIAL_TP_PCT=0.5
PARTIAL_TP_TRIGGER_PCT=0.30

# ==================== Database & Redis ====================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/memebot
REDIS_URL=redis://localhost:6379/0

# ==================== Admin / API ====================
ADMIN_API_HOST=0.0.0.0
ADMIN_API_PORT=8080
# CHANGE THIS before exposing the admin API to any network:
ADMIN_API_KEY=change-me-in-production

# ==================== Admin Panel (web login) ====================
ADMIN_USERNAME=admin
# CHANGE THESE before running anywhere but your own laptop:
ADMIN_PASSWORD=admin123
ADMIN_SESSION_SECRET=change-this-session-secret-in-production
